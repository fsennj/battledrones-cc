diff --git a/src/xr/nachtkonvoi.ts b/src/xr/nachtkonvoi.ts
new file mode 100644
index 0000000..a3f2a84
--- /dev/null
+++ b/src/xr/nachtkonvoi.ts
@@ -0,0 +1,56 @@
+import type { AudioEngine } from "../game/audio";
+
+const trackUrl = new URL("../../art/xr/sound/music/stahltrieb/langfassungen/08-nachtkonvoi.mp3", import.meta.url).href;
+const musicLevel = 0.32;
+const speechLevel = musicLevel * 10 ** (-10 / 20);
+
+/** Opt-in Zillertal soundtrack, on the same Music bus as the table ambience. */
+export class Nachtkonvoi {
+  private pending: Promise<void> | undefined;
+  private buffer: AudioBuffer | undefined;
+  private playback: { source: AudioBufferSourceNode; level: GainNode } | undefined;
+  private speaking = false;
+
+  prepare(ctx: AudioContext): Promise<void> {
+    return this.pending ??= fetch(trackUrl).then((response) => {
+      if (!response.ok) throw new Error(`Nachtkonvoi HTTP ${response.status}`);
+      return response.arrayBuffer();
+    }).then((bytes) => ctx.decodeAudioData(bytes)).then((buffer) => {
+      this.buffer = buffer;
+    }).catch((error: unknown) => { console.warn("Nachtkonvoi:", error); });
+  }
+
+  update({ ctx, musicIn }: AudioEngine): void {
+    if (!this.buffer) {
+      void this.prepare(ctx);
+      return;
+    }
+    if (this.playback) return;
+    const source = ctx.createBufferSource();
+    source.buffer = this.buffer;
+    source.loop = true;
+    const level = ctx.createGain();
+    level.gain.value = 0;
+    source.connect(level).connect(musicIn);
+    this.playback = { source, level };
+    this.setSpeech(this.speaking);
+    source.start();
+  }
+
+  setSpeech(active: boolean): void {
+    this.speaking = active;
+    if (!this.playback) return;
+    const { level } = this.playback;
+    const now = level.context.currentTime;
+    level.gain.cancelAndHoldAtTime(now);
+    level.gain.setTargetAtTime(active ? speechLevel : musicLevel, now, active ? 0.035 : 0.18);
+  }
+
+  stop(): void {
+    if (!this.playback) return;
+    const { source, level } = this.playback;
+    source.stop();
+    level.disconnect();
+    this.playback = undefined;
+  }
+}
